# Supabase (chỉ server dùng — tuyệt đối không đặt sau NEXT_PUBLIC_)
NEXT_PUBLIC_APP_URL=https://zalo.me/momfishworld
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Cron
CRON_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Ký session cookie (>= 16 ký tự, random). Bắt buộc — dùng để chống giả danh.
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Zalo Mini App
ZALO_APP_ID=
# Zalo OA (không có thì chỉ không push, không lỗi)
ZALO_OA_ACCESS_TOKEN=
# (tuỳ chọn) App Secret của Zalo Mini App: bật appsecret_proof khi xác thực token
ZALO_APP_SECRET=

# Dev only — PHẢI xoá/để trống khi lên production
# ALLOW_GUEST_SESSION=1 : cho phép đăng nhập khách ngoài Zalo (test trên browser)
# ALLOW_DEV_BOTS=1      : cho phép API thêm bot (kèm NEXT_PUBLIC_DEV_BOTS=1 để hiện nút trong phòng chờ)
# ALLOW_DEV_BOTS=1
# NEXT_PUBLIC_DEV_BOTS=1

# Khi frontend (Zalo Mini App) chạy ở domain khác với API này:
# ALLOWED_ORIGINS=https://h5.zdn.vn   (nhiều origin: phân cách bằng dấu phẩy)
# NEXT_PUBLIC_API_BASE=https://YOUR-APP.vercel.app  (đặt ở phía frontend)
